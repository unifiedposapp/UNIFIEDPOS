# Asia-Pacific region stack — see deploy/regions/README.md for the full contract.
# Fly region: nrt (Tokyo) or sin (Singapore) · AWS region: ap-northeast-1
# example host: apac.example.com. Residency: keep APAC tenants' data in-region.
NODE_ENV=production
PORT=3001

# REGION-SPECIFIC
DATABASE_URL="postgresql://pos:REPLACE@apac-db.internal:5432/unified_pos?schema=public"
CORS_ORIGIN="https://apac.example.com"
APP_BASE_URL="https://apac.example.com"

# UNIQUE PER REGION
JWT_SECRET="REPLACE-apac-48-byte-hex"
ENCRYPTION_KEY="REPLACE-apac-32-byte-base64"

TRUST_PROXY=1
WEB_DIST=/app/packages/web/dist
STRICT_PROD_CONFIG=true
SKIP_MIGRATIONS=true
SCHEDULER_ENABLED=false

EMAIL_PROVIDER=resend
RESEND_API_KEY="re_REPLACE"
EMAIL_FROM="Unified POS <no-reply@example.com>"

METRICS_TOKEN="REPLACE-apac-scrape-token"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# SENTRY_DSN="https://KEY@ORG.ingest.sentry.io/ID"
