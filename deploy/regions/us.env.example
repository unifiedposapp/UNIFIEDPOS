# US-East region stack — see deploy/regions/README.md for the full contract.
# Fly region: iad · AWS region: us-east-1 · example host: us.example.com
NODE_ENV=production
PORT=3001

# REGION-SPECIFIC
DATABASE_URL="postgresql://pos:REPLACE@us-db.internal:5432/unified_pos?schema=public"
CORS_ORIGIN="https://us.example.com"
APP_BASE_URL="https://us.example.com"

# UNIQUE PER REGION
JWT_SECRET="REPLACE-us-48-byte-hex"
ENCRYPTION_KEY="REPLACE-us-32-byte-base64"

TRUST_PROXY=1
WEB_DIST=/app/packages/web/dist
STRICT_PROD_CONFIG=true
SKIP_MIGRATIONS=true
SCHEDULER_ENABLED=false

EMAIL_PROVIDER=resend
RESEND_API_KEY="re_REPLACE"
EMAIL_FROM="Unified POS <no-reply@example.com>"

METRICS_TOKEN="REPLACE-us-scrape-token"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# SENTRY_DSN="https://KEY@ORG.ingest.sentry.io/ID"
