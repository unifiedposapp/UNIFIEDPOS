// ─── IDEMPOTENCY (§36) ─────────────────────────────────────────────────────
// DB-backed idempotency so duplicate POST/PUT/PATCH carrying the same
// Idempotency-Key are deduped across ALL server instances and restarts. The
// previous in-memory Map lost keys on restart and never shared state across
// instances, so two servers (or a redeploy) could both process the same key →
// double charge. The compound unique constraint is the concurrency guard:
// exactly one request can own a key at a time; losers back off.
model IdempotencyKey {
  id             String   @id @default(uuid())
  scope          String   // `${organizationId}:${userId}` — the authenticated subject
  idempotencyKey String
  method         String
  path           String
  status         String   @default("PROCESSING") // PROCESSING | COMPLETED
  responseStatus Int?
  responseBody   String?  // JSON-serialized response body
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([scope, idempotencyKey, method, path])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─── RATE LIMITING (§37) ───────────────────────────────────────────────────
// Shared, cross-instance fixed-window counters for the security-critical
// limiters (auth brute-force, payment abuse). The unique constraint makes the
// per-window increment atomic across instances. The global high-volume API
// limiter stays in-memory (per-instance) to avoid a DB write on every request.
model RateLimitCounter {
  id          String   @id @default(uuid())
  bucket      String   // limiter name, e.g. "auth" | "payment"
  key         String   // client key, typically the IP address
  windowStart DateTime // fixed-window boundary (floored to windowSeconds)
  count       Int      @default(0)
  expiresAt   DateTime // windowStart + window, for periodic cleanup

  @@unique([bucket, key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

