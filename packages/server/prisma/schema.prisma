generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT & ORGANIZATION ────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  industry  String   @default("RETAIL") // RETAIL, RESTAURANT, SERVICES
  currency  String   @default("USD")
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  phone     String?
  email     String?
  address   String?
  country   String?  // full country name (e.g. "Nigeria")
  countryCode String? // ISO 3166-1 alpha-2 (e.g. "NG")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations       Location[]
  regions         Region[]
  warehouses      Warehouse[]
  employees       Employee[]
  customers       Customer[]
  products        Product[]
  categories      Category[]
  brands          Brand[]
  suppliers       Supplier[]
  taxRules        TaxRule[]
  registers       Register[]
  devices         Device[]
  orders          Order[]
  auditEvents     AuditEvent[]
  webhooks        Webhook[]
  businessEvents  BusinessEvent[]
  accountingEntries AccountingEntry[]
  loyaltyPrograms LoyaltyProgram[]
  loyaltyTransactions LoyaltyTransaction[]
  tables          RestaurantTable[]
  promotions      Promotion[]
  coupons         Coupon[]
  campaigns       Campaign[]
  invoices        Invoice[]
  expenses        Expense[]
  stockTransfers  StockTransfer[]
  stockCounts     StockCount[]
  refunds         Refund[]
  payouts         Payout[]
  priceLists      PriceList[]
  shifts          Shift[]
  tips            Tip[]
  commissions     Commission[]
  purchaseOrders  PurchaseOrder[]
  giftCards       GiftCard[]
  storeCredits    StoreCredit[]
  layaways        Layaway[]
  roles           Role[]
  integrations    IntegrationConnection[]
  customerEvents  CustomerEvent[]
  customerProfiles CustomerProfile[]
  customerPreferences CustomerPreference[]
  marketingEvents MarketingEvent[]
  rewards         Reward[]
  bundles         Bundle[]
  kits            Kit[]
  compositeProducts CompositeProduct[]
  paymentTransactions PaymentTransaction[]
  salesChannels   SalesChannel[]
  deliveryZones   DeliveryZone[]
  syncTransactions SyncTransaction[]
  notifications   Notification[]
  notificationPreferences NotificationPreference[]
  inventoryBatches InventoryBatch[]
  serialNumbers   SerialNumber[]

  @@map("organizations")
}

model Location {
  id              String   @id @default(uuid())
  organizationId  String
  regionId        String?
  name            String
  address         String?
  phone           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id])
  registers    Register[]
  employees    EmployeeLocation[]
  inventory    InventoryBalance[]
  orders       Order[]
  deliveryZones DeliveryZone[]
  batches       InventoryBatch[]

  @@map("locations")
}

model Register {
  id          String   @id @default(uuid())
  organizationId String
  locationId  String
  name        String
  status      String   @default("CLOSED") // CLOSED, OPENING, OPEN, SUSPENDED, CLOSING
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  sessions     RegisterSession[]
  orders       Order[]

  @@map("registers")
}

model RegisterSession {
  id            String    @id @default(uuid())
  registerId    String
  employeeId    String
  openingCash   Decimal   @default(0) @db.Decimal(10, 2)
  closingCash   Decimal?  @db.Decimal(10, 2)
  expectedCash  Decimal?  @db.Decimal(10, 2)
  variance      Decimal?  @db.Decimal(10, 2)
  status        String    @default("OPEN") // OPEN, CLOSING, CLOSED
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  notes         String?

  register Register @relation(fields: [registerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("register_sessions")
}

model Device {
  id              String   @id @default(uuid())
  organizationId  String
  locationId      String?
  registerId      String?
  name            String
  type            String   @default("POS_TERMINAL") // POS_TERMINAL, MOBILE, KIOSK, KITCHEN_DISPLAY
  status          String   @default("ONLINE") // ONLINE, OFFLINE, MAINTENANCE, RETIRED
  deviceCredential String? // encrypted device auth token
  lastSyncAt      DateTime?
  lastHeartbeatAt DateTime?
  softwareVersion String?
  configVersion   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("devices")
}

// ─── IDENTITY & AUTH ──────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CASHIER") // OWNER, ADMIN, MANAGER, CASHIER
  isActive  Boolean  @default(true)
  resetToken String? // hashed password-reset token (§37 secrets never stored in plain text)
  resetTokenExpires DateTime?
  mfaSecret         String?   // base32 TOTP secret (§37 MFA); never returned once enabled
  mfaEnabled        Boolean   @default(false)
  failedLoginAttempts Int     @default(0)  // §37 account-lockout counter
  lockedUntil       DateTime?              // §37 temporary lockout expiry
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee?

  @@map("users")
}

model BreachIncident {
  id                  String    @id @default(uuid())
  organizationId      String
  title               String
  description         String?
  severity            String    @default("MEDIUM")   // LOW, MEDIUM, HIGH, CRITICAL
  status              String    @default("DETECTED") // DETECTED, ASSESSED, NOTIFIED, CLOSED
  affectedRecords     Int       @default(0)
  detectedAt          DateTime  @default(now())
  assessedAt          DateTime?
  regulatorNotifiedAt DateTime?
  individualsNotifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId, status])
  @@map("breach_incidents")
}

model Employee {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String   @unique
  roleId          String?
  employeeNumber  String?
  department      String?
  position        String?
  hourlyRate      Decimal? @db.Decimal(10, 2)
  commissionRate  Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  role         Role?             @relation(fields: [roleId], references: [id])
  locations    EmployeeLocation[]
  sessions     RegisterSession[]
  orders       Order[]
  timeEntries  TimeEntry[]
  auditEvents  AuditEvent[]
  shifts       Shift[]
  tips         Tip[]
  commissions  Commission[]

  @@map("employees")
}

model EmployeeLocation {
  id         String @id @default(uuid())
  employeeId String
  locationId String

  employee Employee @relation(fields: [employeeId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([employeeId, locationId])
  @@map("employee_locations")
}

// ─── CUSTOMERS ────────────────────────────────────────────────

model Customer {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  email           String?
  phone           String?
  address         String?
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  totalOrders     Int      @default(0)
  averageOrderValue Decimal @default(0) @db.Decimal(10, 2)
  visitFrequency   Decimal  @default(0) @db.Decimal(5, 2)
  loyaltyPoints   Int      @default(0)
  lastVisitAt     DateTime?
  preferredLocationId String?
  birthday        DateTime?
  marketingOptIn  Boolean  @default(false)
  tags            String[]
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id])
  orders         Order[]
  loyaltyTransactions LoyaltyTransaction[]
  refunds        Refund[]
  invoices       Invoice[]
  profiles       CustomerProfile[]
  preferences    CustomerPreference[]
  events         CustomerEvent[]
  giftCards      GiftCard[]
  storeCredits   StoreCredit[]

  @@map("customers")
}

// ─── PRODUCT CATALOG ──────────────────────────────────────────

model Category {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  color           String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@map("categories")
}

model Brand {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@map("brands")
}

model Product {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  sku             String
  barcode         String?
  description     String?
  type            String   @default("PHYSICAL")
  price           Decimal  @db.Decimal(10, 2)
  costPrice       Decimal  @db.Decimal(10, 2)
  categoryId      String?
  brandId         String?
  taxRuleId       String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  category     Category?           @relation(fields: [categoryId], references: [id])
  brand        Brand?              @relation(fields: [brandId], references: [id])
  taxRule      TaxRule?            @relation(fields: [taxRuleId], references: [id])
  variants     ProductVariant[]
  inventory    InventoryBalance[]
  orderItems   OrderItem[]
  modifiers    Modifier[]
  batches      InventoryBatch[]
  serials      SerialNumber[]

  @@unique([organizationId, sku])
  @@map("products")
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  name        String  // e.g. "Size", "Color"
  value       String  // e.g. "Large", "Red"
  priceAdj    Decimal @default(0) @db.Decimal(10, 2)
  sku         String?
  barcode     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ModifierGroup {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  minSelect      Int        @default(0)
  maxSelect      Int        @default(0)
  modifiers      Modifier[]

  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(uuid())
  productId       String?
  modifierGroupId String?
  name            String
  priceAdj        Decimal @default(0) @db.Decimal(10, 2)

  product       Product?       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup? @relation(fields: [modifierGroupId], references: [id])

  @@map("modifiers")
}

model TaxRule {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  rate            Decimal  @db.Decimal(5, 2)
  isActive        Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@map("tax_rules")
}

// ─── INVENTORY ENGINE ─────────────────────────────────────────

model InventoryBalance {
  id          String @id @default(uuid())
  productId   String
  locationId  String
  quantity    Int    @default(0)
  reserved    Int    @default(0)
  damaged     Int    @default(0)
  reorderPoint Int   @default(0)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  movements InventoryMovement[]

  @@unique([productId, locationId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id          String   @id @default(uuid())
  balanceId   String
  type        String   // SALE, PURCHASE, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT, RETURN, DAMAGED, COUNT
  quantity    Int
  reference   String?  // order_id, po_id, etc.
  notes       String?
  performedBy String?
  createdAt   DateTime @default(now())

  balance InventoryBalance @relation(fields: [balanceId], references: [id])

  @@map("inventory_movements")
}

// ─── NOTIFICATIONS (§5 Notification domain) ───────────────────
model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String?   // null = org-wide broadcast
  type           String    // LOW_STOCK, OUT_OF_STOCK, PAYMENT_FAILED, CHARGEBACK, DISPUTE, DEVICE_OFFLINE, SYNC_CONFLICT, ORDER_COMPLETED, SYSTEM, MARKETING
  severity       String    @default("INFO") // INFO, WARNING, CRITICAL
  title          String
  message        String
  data           Json?
  sourceEvent    String?   // originating §27 business event name
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, isRead])
  @@index([organizationId, userId])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   @unique
  email          Boolean  @default(true)
  sms            Boolean  @default(false)
  push           Boolean  @default(true)
  inApp          Boolean  @default(true)
  lowStock       Boolean  @default(true)
  paymentIssues  Boolean  @default(true)
  marketing      Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_preferences")
}

// ─── INVENTORY BATCH / SERIAL TRACKING (§12) ──────────────────
model InventoryBatch {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  locationId     String
  batchNumber    String    // lot / batch identifier
  expirationDate DateTime? // perishables (§12 expiration dates)
  quantity       Int       @default(0)
  remaining      Int       @default(0)
  unitCost       Decimal?  @db.Decimal(10, 2)
  supplierId     String?
  receivedAt     DateTime  @default(now())
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, DEPLETED, RECALLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  product      Product        @relation(fields: [productId], references: [id])
  location     Location       @relation(fields: [locationId], references: [id])
  serials      SerialNumber[]

  @@unique([organizationId, productId, batchNumber])
  @@index([organizationId, expirationDate])
  @@map("inventory_batches")
}

model SerialNumber {
  id              String    @id @default(uuid())
  organizationId  String
  productId       String
  batchId         String?
  serial          String
  status          String    @default("IN_STOCK") // IN_STOCK, RESERVED, SOLD, RETURNED, DEFECTIVE, IN_REPAIR
  locationId      String?
  soldOrderItemId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  product      Product         @relation(fields: [productId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])

  @@unique([organizationId, productId, serial])
  @@index([organizationId, status])
  @@map("serial_numbers")
}

model Supplier {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("suppliers")
}

// ─── ORDER MANAGEMENT ─────────────────────────────────────────

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  organizationId  String
  locationId      String?
  registerId      String?
  sessionId       String?
  employeeId      String?
  customerId      String?
  channel         String   @default("IN_STORE") // IN_STORE, WEBSITE, MOBILE_APP, PHONE, SOCIAL, MARKETPLACE, POP_UP
  status          String   @default("DRAFT")    // DRAFT, HELD, CONFIRMED, PAID, PROCESSING, FULFILLED, COMPLETED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED
  currency        String   @default("USD")
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(10, 2)
  tipAmount       Decimal  @default(0) @db.Decimal(10, 2)
  serviceCharge   Decimal  @default(0) @db.Decimal(10, 2)
  couponCode      String?
  fulfillmentType String   @default("TAKEOUT") // DINE_IN, TAKEOUT, DELIVERY, PICKUP, SHIP, CURBSIDE
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  register     Register?     @relation(fields: [registerId], references: [id])
  employee     Employee?     @relation(fields: [employeeId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  discounts    OrderDiscount[]
  taxes        OrderTax[]
  payments     Payment[]
  fulfillments OrderFulfillment[]
  refunds      Refund[]
  invoices     Invoice[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  variantName  String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  discountAmt  Decimal @default(0) @db.Decimal(10, 2)
  taxAmt       Decimal @default(0) @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)
  notes        String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderDiscount {
  id        String  @id @default(uuid())
  orderId   String
  type      String  // PERCENTAGE, FIXED, COUPON
  value     Decimal @db.Decimal(10, 2)
  reason    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_discounts")
}

model OrderTax {
  id      String  @id @default(uuid())
  orderId String
  name    String
  rate    Decimal @db.Decimal(5, 2)
  amount  Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_taxes")
}

model OrderFulfillment {
  id          String    @id @default(uuid())
  orderId     String
  type        String    // PICKUP, DELIVERY, SHIP, DINE_IN, TAKEOUT, CURBSIDE
  status      String    @default("PENDING") // PENDING, PREPARING, READY, OUT_FOR_DELIVERY, SHIPPED, DELIVERED, COMPLETED, CANCELLED, FAILED
  notes       String?
  // ── Commerce Hub fulfillment details (§13 Omnichannel) ──
  scheduledAt    DateTime?
  readyAt        DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  recipientName  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  phoneNumber    String?
  courier        String?  // local courier / driver name
  carrier        String?  // UPS, FedEx, USPS (shipping)
  trackingNumber String?
  deliveryFee    Decimal   @default(0) @db.Decimal(10, 2)
  distanceMiles  Decimal?  @db.Decimal(6, 2)
  etaMinutes     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_fulfillments")
}

// ─── PAYMENT SYSTEM ───────────────────────────────────────────

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  method          String   // CASH, CARD, TAP, CHIP, APPLE_PAY, GOOGLE_PAY, GIFT_CARD, STORE_CREDIT, ACH, QR, BNPL, OTHER
  provider        String?  // stripe, square, etc.
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  status          String   @default("COMPLETED") // AUTHORIZED, CAPTURED, SETTLED, RECONCILED, COMPLETED, DECLINED, VOIDED, REFUNDED, PARTIALLY_REFUNDED, CHARGEBACK, DISPUTED, FAILED, REVERSED
  reference       String?  // processor transaction id
  idempotencyKey  String?  @unique
  authorizationId String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds      Refund[]
  payouts      Payout[]
  transactions PaymentTransaction[]

  @@map("payments")
}

// ─── TIME & LABOR ─────────────────────────────────────────────

model TimeEntry {
  id         String    @id @default(uuid())
  employeeId String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("time_entries")
}

// ─── AUDIT SYSTEM ─────────────────────────────────────────────

model AuditEvent {
  id              String   @id @default(uuid())
  organizationId  String
  actorId         String?  // employee who performed action
  deviceId        String?
  action          String   // REFUND_CREATED, DISCOUNT_APPLIED, PRICE_CHANGED, etc.
  resourceType    String   // ORDER, PRODUCT, INVENTORY, EMPLOYEE, etc.
  resourceId      String?
  previousValue   Json?
  newValue        Json?
  metadata        Json?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        Employee?    @relation(fields: [actorId], references: [id])

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, action])
  @@map("audit_events")
}

// ─── STORE SETTINGS ───────────────────────────────────────────

model StoreSettings {
  id                   String  @id @default(uuid())
  organizationId       String  @unique
  storeName            String
  address              String?
  phone                String?
  phoneDialCode        String?   // international dial code (e.g. "+234")
  email                String?
  receiptFooter        String?
  lowStockAlertEnabled Boolean @default(true)

  // ── Branding & business customization ──
  tagline              String?   // short brand slogan
  businessDescription  String?   // about the business
  website              String?   // public website URL
  logoUrl              String?   // base64 data URL or hosted path
  faviconUrl           String?   // base64 data URL or hosted path
  coverUrl             String?   // banner / cover graphic
  brandPrimaryColor    String?   @default("#2563eb")
  brandSecondaryColor  String?
  socialLinks          Json?     // { facebook, instagram, x, linkedin, youtube, tiktok }
  media                Json?     // [{ id, name, type, dataUrl, size, uploadedAt }]

  // ── Data governance (§37 retention & legal hold) ──
  dataRetentionDays    Int?      // days to retain personal data; null = keep indefinitely
  legalHold            Boolean   @default(false)  // suspend purging while a litigation hold is active

  // ── Structured worldwide address ──
  streetAddress        String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?   // full country name (e.g. "Nigeria")
  countryCode          String?   // ISO 3166-1 alpha-2 (e.g. "NG")
  timezone             String?
  currency             String?
  taxId                String?   // VAT / TIN / business registration id

  @@map("store_settings")
}

// ─── COMPLIANCE (Privacy / GDPR / CCPA / PCI-DSS) ─────────────
// Standalone (no relation), scoped by organizationId — mirrors StoreSettings.

model ComplianceRecord {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String?
  type            String   // CONSENT | COOKIE | DSAR_EXPORT | DSAR_DELETE
  status          String   @default("RECEIVED") // RECEIVED | FULFILLED | DENIED
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, type])
  @@map("compliance_records")
}

// ─── EVENT ARCHITECTURE (§27) ─────────────────────────────────

model BusinessEvent {
  id              String   @id @default(uuid())
  organizationId  String
  event           String   // order.created, payment.completed, inventory.changed, etc.
  data            Json
