// ─── OFFLINE-FIRST SYNC ENGINE (§25 / §26) ───────────────────
// Every locally created transaction carries an immutable client-generated
// transactionId. On sync the server dedupes on (organizationId, transactionId):
// already-seen ids return their original result instead of re-processing (§26).
model SyncTransaction {
  id              String   @id @default(uuid())
  organizationId  String
  deviceId        String   // DEVICE UUID
  transactionId   String   // client-generated immutable UUID (idempotency key)
  sequenceNo      Int      // LOCAL SEQUENCE
  type            String   // SALE, REFUND, PAYMENT, INVENTORY_ADJUSTMENT, ORDER
  payload         Json     // the offline transaction body
  status          String   @default("SYNCED") // SYNCED, DUPLICATE, CONFLICT, FAILED
  deviceTimestamp DateTime // DEVICE TIMESTAMP
  syncedAt        DateTime @default(now())
  result          Json?    // server result returned to the device
  conflictReason  String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, transactionId])
  @@index([organizationId, deviceId])
  @@index([organizationId, status])
  @@map("sync_transactions")
}

// ─── PAYMENT LINKS (§9) ───────────────────────────────────────
// Hosted "pay by link": a merchant creates a link for an amount; the payer opens
// it and pays via the PSP (Stripe Elements), so card data never touches us.
// Standalone and org-scoped — mirrors the BreachIncident/ComplianceRecord pattern.
model PaymentLink {
  id              String    @id @default(uuid())
  organizationId  String
  token           String    @unique
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("USD")
  description     String?
  customerId      String?
  orderId         String?
  status          String    @default("ACTIVE") // ACTIVE, PAID, EXPIRED, CANCELLED
  maxPayments     Int       @default(1)        // >1 makes the link reusable
  paymentCount    Int       @default(0)
  expiresAt       DateTime?
  paidAt          DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, status])
  @@map("payment_links")
}

