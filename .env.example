# ─────────────────────────────────────────────────────────────────────────────
# Unified POS — environment template
# Copy to `.env` for local dev, or set these as secrets in your host's dashboard
# (Render / Railway / Fly.io / ECS / Cloud Run). NEVER commit the real `.env`.
#
# Values marked "REQUIRED in production" have no safe fallback: the server will
# refuse to start (or refuse to sign tokens) if they are missing when
# NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Public host port the container is published on (docker-compose only).
APP_PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────
# Local dev / single-instance connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/unified_pos?schema=public"

# docker-compose builds DATABASE_URL from these parts (managed Postgres):
POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me-strong-db-password   # REQUIRED in production
POSTGRES_DB=unified_pos

# ─── Auth / JWT ───────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to sign tokens without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="8h"

# ─── Encryption at rest (§37) ─────────────────────────────────────────────
# REQUIRED in production. Key used to AES-256-GCM encrypt stored integration
# credentials. Changing it after data is written makes existing rows undecryptable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-to-a-long-random-passphrase"

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. In production set this to your
# public URL(s), e.g. "https://pos.example.com,https://admin.example.com".
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# ─── Reverse proxy / hosting ──────────────────────────────────────────────
# Number of proxy hops to trust (behind Docker/Cloud Run/nginx use 1).
TRUST_PROXY=1
# Folder holding the built SPA served by the API in single-container deploys.
WEB_DIST=/app/packages/web/dist
# Set true to run `prisma migrate deploy` from CI/a one-off job instead of on
# every container boot (entrypoint).
SKIP_MIGRATIONS=false
# Set true only to debug Content-Security-Policy issues; leave off in production.
DISABLE_CSP=false

# ─── Payments (Stripe) ────────────────────────────────────────────────────
# Optional. When STRIPE_SECRET_KEY is unset the app uses a built-in simulator so
# checkout works in dev with no keys and no network. Set these to take real money.
# Card data is collected client-side by Stripe Elements (tokenized pm_...), so it
# never touches this server (PCI SAQ-A scope).
# STRIPE_SECRET_KEY="sk_test_..."            # REQUIRED for real charges
# STRIPE_PUBLISHABLE_KEY="pk_test_..."       # sent to the SPA for Stripe Elements
# STRIPE_WEBHOOK_SECRET="whsec_..."          # REQUIRED to verify webhook signatures

# ─── Session cookies / CSRF (§37) ─────────────────────────────────────────
# Auth is dual-mode: the SPA can use the httpOnly session cookie (XSS-hardened)
# or the Authorization: Bearer header. Cookie attributes:
COOKIE_SAMESITE=lax            # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_SECURE=true           # force the Secure flag (auto-on when NODE_ENV=production)
# COOKIE_MAX_AGE_MS=28800000   # cookie lifetime (default 8h, aligns with JWT)

# ─── Transactional email (§37 password reset, §5 notifications) ────────────
# ZERO hard dependencies: pick ONE provider by setting its key. With none set, the
# server logs and skips sending (a safe no-op in local dev).
# SECURITY: in production /forgot-password NEVER returns the reset token to the
# client — it is only ever emailed — so configure a provider before going live.
# EMAIL_PROVIDER=resend          # resend | sendgrid | smtp | none (auto-detected from keys when unset)
# EMAIL_FROM="Unified POS <no-reply@yourdomain.com>"
# APP_BASE_URL="https://pos.example.com"   # base for links in emails (falls back to CORS_ORIGIN)
# RESEND_API_KEY="re_..."        # https://resend.com   (HTTPS REST via the global fetch)
# SENDGRID_API_KEY="SG...."      # https://sendgrid.com (HTTPS REST via the global fetch)
# SMTP_HOST="smtp.example.com"   # then run: npm i nodemailer (optional, loaded at runtime)
# SMTP_PORT=587
# SMTP_SECURE=false              # true = implicit TLS (usually port 465)
# SMTP_USER="no-reply@yourdomain.com"
# SMTP_PASS="change-me"

# ─── Observability (§39) ──────────────────────────────────────────────────
# Optional. Sentry activates only when SENTRY_DSN is set (then run: npm i @sentry/node).
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<id>"
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Token-gate the Prometheus endpoint GET /api/metrics (open if unset).
# METRICS_TOKEN="change-me"

# ─── Media / object storage (§ media library) ─────────────────────────────
# Optional. When AWS_S3_BUCKET + credentials are set, product images and brand
# assets are stored in S3 (SigV4 signed with node:crypto — no AWS SDK) and served
# via short-lived presigned URLs. When unset, media falls back to the database
# (base64) so the feature works with zero config.
# AWS_S3_BUCKET="your-bucket"                 # REQUIRED to enable S3
# AWS_ACCESS_KEY_ID="AKIA..."                 # REQUIRED in production
# AWS_SECRET_ACCESS_KEY="..."                 # REQUIRED in production
# AWS_REGION="us-east-1"                      # REQUIRED to enable S3
# AWS_S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"  # optional (S3-compatible stores)
# AWS_SESSION_TOKEN="..."                     # optional (temporary credentials)

# ─── Web Push / VAPID (§5 browser notifications) ──────────────────────────
# Optional. Web push is disabled until all three are set. Generate a keypair with
# GET /api/push/vapid-keys (OWNER only) or: npx web-push generate-vapid-keys.
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push service.
# VAPID_PUBLIC_KEY="B..."                     # base64url public key (also sent to the SPA)
# VAPID_PRIVATE_KEY="..."                     # base64url private key
# VAPID_SUBJECT="mailto:ops@yourdomain.com"

# ─── LLM Copilot (§21/§22 natural-language insights) ──────────────────────
# Optional. The copilot uses a deterministic statistical fallback with no keys.
# Set an OpenAI-compatible key to augment answers with an LLM (HTTPS via fetch).
# LLM_API_KEY="sk-..."                        # or OPENAI_API_KEY
# OPENAI_API_KEY="sk-..."                     # alternative to LLM_API_KEY
# LLM_BASE_URL="https://api.openai.com/v1"    # any OpenAI-compatible endpoint
# LLM_MODEL="gpt-4o-mini"

# ─── Background job scheduler (§19/§10/§29/§37/§12) ───────────────────────
# In-process tick scheduler for campaigns, payouts, webhook retry, retention
# purge, low-stock, and stored-value/loyalty expiry. Jobs are idempotent, but in
# a multi-instance deployment enable it on EXACTLY ONE leader to avoid duplicate
# side effects.
SCHEDULER_ENABLED=true          # set false on all but one instance
# SCHEDULER_TICK_MS=15000       # tick interval (min 1000)

# ─── Fraud detection tuning (§37) ─────────────────────────────────────────
# Optional. All thresholds have safe defaults; override per your risk appetite.
# A transaction's additive risk score (capped at 100) is compared to the review
# and block scores to decide ALLOW / REVIEW / BLOCK.
# FRAUD_LARGE_AMOUNT=5000               # single-payment amount that scores LARGE_AMOUNT
# FRAUD_VELOCITY_PER_HOUR=6             # payment attempts / hour before VELOCITY fires
# FRAUD_REFUNDS_PER_DAY=4               # refunds / 24h before RAPID_REFUNDS fires
# FRAUD_DEVICE_CUSTOMERS_PER_HOUR=8     # distinct customers / device before DEVICE_VELOCITY
# FRAUD_GIFTCARD_PER_HOUR=5             # gift-card funding events / hour before GIFT_CARD_ABUSE
# FRAUD_REVIEW_SCORE=40                 # score at/above which a payment is held for REVIEW
# FRAUD_BLOCK_SCORE=70                  # score at/above which a payment is BLOCKed
